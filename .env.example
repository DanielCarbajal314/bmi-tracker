# Copy to .env (make env does it). Never commit .env.

# Backend
NODE_ENV=development
PORT=3000

# Database (read by the backend, the migration container and the postgres container)
DB_HOST=database
DB_PORT=5432
DB_USER=bmi
DB_PASSWORD=change-me
DB_NAME=bmi
DB_SSL=false

# Origins allowed to call the API from a browser, comma separated. Leave empty in development
# (Vite proxies /api); the deployed backend gets it from Terraform.
CORS_ORIGINS=

# Host ports mapped to the containers
DB_EXPOSED_PORT=5432
BACKEND_EXPOSED_PORT=3001
FRONTEND_EXPOSED_PORT=5174
