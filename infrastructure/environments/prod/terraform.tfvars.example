# Optional: terraform.tfvars is ignored by git, and `make infra-apply` works without it.
# `make` already passes aws_region, project, image_tag and github_repo (the origin remote of git).

# alert_email                 = "you@example.com"  # receives the CloudWatch alarms
# github_repo                 = "owner/repo"       # only when it is not the origin remote
# create_github_oidc_provider = false              # the account already has GitHub's identity provider
# desired_count               = 2
# db_instance_class           = "db.t4g.small"
# db_multi_az                 = true
